DB_USER=sa
DB_PASSWORD=Sa1234*
DB_SERVER=localhost
DB_DATABASE=ferreterias_db
GOOGLE_API_KEY=
GEMINI_API_KEY=


PROMPT_COMPLETO="Eres un EXPERTO en analizar imágenes de ferreterías. Analiza estas imágenes de '{nombre_negocio}'. REGLA: NO inventes información. Busca: 1) ¿Venden cemento o materiales de construcción? 2) Número de WhatsApp (10 dígitos que empiecen con 3) 3) Teléfono fijo (7-8 dígitos). Responde SOLO en JSON: {\"vende_lo_que_buscamos\": true/false, \"productos_observados\": [\"producto1\"], \"whatsapp\": \"numero\", \"telefono_fijo\": \"numero\", \"nivel_confianza\": \"alto/media/bajo\"}"

# Configuración específica de Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1

# Configuración específica de URLs (Endpoints)
GOOGLE_MAPS_URL=https://maps.googleapis.com/maps/api/place/nearbysearch/json
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1/models/

# ================================
# AWS Rekognition
# ================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1